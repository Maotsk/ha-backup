# ============================================
# HA Backup — конфигурация
# ============================================
# Скопируйте этот файл в /root/.ha-backup.conf
# и заполните своими значениями.
#
#   sudo cp .ha-backup.conf.example /root/.ha-backup.conf
#   sudo nano /root/.ha-backup.conf
#   sudo chmod 600 /root/.ha-backup.conf
# ============================================

# ---------- Куда бэкапить ----------
# DEST         — путь на смонтированной шаре
# MOUNTPOINT   — точка монтирования (проверяется перед бэкапом)
# LOGDIR       — где хранить логи
DEST="/mnt/ha-dataset/backup/"
MOUNTPOINT="/mnt/ha-dataset"
LOGDIR="/var/log.hdd/ha"

# ---------- Ограничение скорости rsync (КБ/с) ----------
# 0 = без ограничения
# 5000 = ~5 МБ/с (щадящий режим для слабых SBC и медленной сети)
BW_LIMIT="5000"

# ---------- Сколько дней хранить логи ----------
# Логи старше указанного количества дней удаляются автоматически
LOG_RETENTION_DAYS="7"

# ============================================
# Telegram — уведомления
# ============================================
# Оставьте TG_TOKEN и TG_CHAT_ID пустыми,
# чтобы полностью отключить уведомления.
#
# Как получить токен: @BotFather → /newbot
# Как узнать chat_id: написать боту, затем
#   curl -s "https://api.telegram.org/bot<ТОКЕН>/getUpdates" \
#     | grep -o '"chat":{"id":[-0-9]*' | head -1
# ============================================

TG_TOKEN=""
TG_CHAT_ID=""

# SOCKS5-прокси (оставьте пустым, если не нужен)
# Формат: socks5h://IP:ПОРТ  или  socks5h://USER:PASS@IP:ПОРТ
# Буква "h" в конце — резолв имени хоста на стороне прокси (рекомендуется).
TG_PROXY="socks5h://127.0.0.1:1080"

# --- Что отправлять ---
# true  = отправлять
# false = не отправлять совсем
TG_NOTIFY_SUCCESS="true"
TG_NOTIFY_ERROR="true"

# --- Тихий режим (без звука/вибрации) ---
# true  = тихо (не разбудит ночью)
# false = со звуком (разбудит)
TG_SILENT_SUCCESS="true"
TG_SILENT_ERROR="false"

# ============================================
# Что бэкапить
# ============================================
# Формат: "ИСТОЧНИК|ПОДПАПКА_НА_ШАРЕ|ИСКЛЮЧЕНИЯ|--delete?"
#
#   ИСТОЧНИК     — что копируем (файл или папка со слешем на конце)
#   ПОДПАПКА     — куда на шаре относительно DEST
#   ИСКЛЮЧЕНИЯ   — маска через запятую (*.log,*.tmp) или пусто
#   --delete?    — yes = удалять на шаре то, чего нет в источнике
#                  no  = только добавлять/обновлять
#
# ВАЖНО: для папок ставьте слеш на конце источника (/ha/),
#        иначе rsync создаст вложенную папку с именем источника.
# ============================================

JOBS=(
    # --- Home Assistant: все данные ---
    "/ha/|backup/ha/|*.log|yes"

    # --- Docker Compose ---
    "/root/docker-compose.yaml|backup/docker-config/||no"

    # --- Скрипты и конфиги (чтобы восстановить бэкап) ---
    "/root/ha-backup.sh|backup/scripts/||no"
    "/root/.ha-backup.conf|backup/scripts/||no"

    # --- Системные файлы для восстановления ---
    "/etc/fstab|backup/system/||no"

    # --- Опционально: раскомментируйте при необходимости ---
    # "/etc/systemd/system/|backup/systemd/||no"
    # "/etc/NetworkManager/system-connections/|backup/network/||no"
    # "/root/.ssh/|backup/ssh/||no"
    # "/etc/crontab|backup/system/||no"
    # "/var/spool/cron/crontabs/|backup/cron/||no"
)
