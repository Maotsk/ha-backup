# =========================================================
# HA Backup — конфигурация
# =========================================================
#
# Этот файл создаётся установщиком.
#
# Что нужно настроить:
#   - DEST        — точка монтирования шары TrueNAS
#   - TG_*        — если нужны уведомления в Telegram
#
# Структура на шаре фиксирована:
#   backup/ha/            ← данные Home Assistant
#   backup/docker-config/ ← docker-compose.yaml
#   backup/scripts/       ← сам скрипт и этот конфиг
#   backup/system/        ← fstab
#
# Если нужны особые пути — см. README, раздел «Расширенная настройка».
# =========================================================

# ---------- Куда бэкапить ----------
# DEST — корень бэкапа на шаре.
# Измените только если у вас другая шара.
DEST="/mnt/ha-dataset/backup/"

# MOUNTPOINT — точка монтирования шары.
# Должна совпадать с тем, что в /etc/fstab.
MOUNTPOINT="/mnt/ha-dataset"

# LOGDIR — каталог для логов. Обычно менять не нужно.
LOGDIR="/var/log.hdd/ha"

# ---------- Ограничение скорости rsync (КБ/с) ----------
# 0 = без ограничения.
# Для слабых SBC и медленной сети ставьте 3000-5000.
BW_LIMIT="5000"

# ---------- Сколько дней хранить логи ----------
LOG_RETENTION_DAYS="7"

# =========================================================
# Telegram (опционально)
# =========================================================
#
# Если уведомления не нужны — оставьте TG_TOKEN и TG_CHAT_ID пустыми.
#
# TG_TOKEN    — токен бота от @BotFather
# TG_CHAT_ID  — ID чата (узнать через getUpdates)
# TG_PROXY    — SOCKS5-прокси, если Telegram недоступен напрямую
# =========================================================

TG_TOKEN=""
TG_CHAT_ID=""
TG_PROXY="socks5h://127.0.0.1:1080"

# Уведомления
TG_NOTIFY_SUCCESS="true"
TG_NOTIFY_ERROR="true"

# Тихий режим (без звука)
TG_SILENT_SUCCESS="true"
TG_SILENT_ERROR="false"

# =========================================================
# Что бэкапить (фиксированная структура)
# =========================================================
#
# Этот блок НЕ рекомендуется менять.
# Он определяет, что и куда складывается на шаре.
#
# Формат: "ИСТОЧНИК|ПОДПАПКА_НА_ШАРЕ|ИСКЛЮЧЕНИЯ|--delete?"
#
# INSTALL_PATH и CONF_PATH подставляются автоматически
# при установке в зависимости от того, где лежит install.sh.
# =========================================================

JOBS=(
    # Home Assistant — все данные
    "/ha/|ha/|*.log|yes"

    # Docker Compose
    "/root/docker-compose.yaml|docker-config/||no"

    # Сам скрипт и конфиг (чтобы восстановить бэкап)
    "INSTALL_PATH|scripts/||no"
    "CONF_PATH|scripts/||no"

    # Системные файлы для восстановления
    "/etc/fstab|system/||no"
)
